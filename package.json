{
  "name": "Fundamentals",
  "version": "1.0.0",
  "description": "Aplikacja desktopowa do analizy fundamentalnej spółek z SEC",
  "main": "dist/main.js",
  "author": "Paweł Lisik",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.pawellisik.fundamentals",
    "productName": "Fundamentals",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "styles.css",
      "package.json",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "icon": "build/icon.png"
    },
    "npmRebuild": false
  },
  "devDependencies": {
    "@electron/rebuild": "^3.2.13",
    "@types/node": "^22.0.0",
    "@types/sqlite3": "^3.1.11",
    "electron": "^44.3.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "yahoo-finance2": "^4.0.2"
  },
  "allowScripts": {
    "sqlite3": true
  }
}